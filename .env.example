# Copy to .env.local and fill in.

# MapTiler key used by the browser for satellite imagery.
# Public by design (inlined into the JS bundle): restrict it to your
# domains in the MapTiler dashboard (Account → Keys → Allowed HTTP origins).
NEXT_PUBLIC_MAPTILER_KEY=

# Neon Postgres (pulled by `neon env pull` / `neon deploy`).
# DATABASE_URL is pooled (app traffic); DATABASE_URL_UNPOOLED is direct (migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Set to 1 only on machines whose IPv6 route to Neon is broken (connections
# time out with AggregateError ETIMEDOUT). See db/network.ts.
PG_FORCE_IPV4=
