# Copy to .env for local runs. On Modal these come from a Modal secret.

# Server-side MapTiler key (use a separate key from the browser one).
MAPTILER_KEY=

# Neon Postgres (pooled URL is fine; the worker only does short UPDATEs).
DATABASE_URL=

# Local tile cache (leave empty to disable).
TILE_CACHE_DIR=.tile-cache

# Optional overrides (defaults in config.py):
# DETECT_ZOOM=19
# SEGMENT_ZOOM=19
# DETECT_MODEL_PATH=models/yolo26s-obb.pt
# SAM_MODEL_PATH=models/sam2.1_s.pt
# SAM_WINDOW=1024
# YOLO_CONF=0.25
# SAHI_SLICE_SIZE=1024
# MODEL_IMGSZ=1024
# COARSE_SCALE=0.25
# SAHI_OVERLAP=0.2
# CONTEXT_TILES=1
# MAX_TILES=450
